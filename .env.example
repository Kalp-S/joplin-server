# PostgreSQL
POSTGRES_DB=joplin
POSTGRES_USER=joplin
POSTGRES_PASSWORD=change-me

# Joplin Server
APP_PORT=22300
APP_BASE_URL=https://joplin.kalp.dev
DB_CLIENT=pg
POSTGRES_HOST=joplin-db
POSTGRES_PORT=5432
POSTGRES_DATABASE=joplin

# Mailer (set MAILER_ENABLED=1 and fill in details to enable email invites)
MAILER_ENABLED=0
